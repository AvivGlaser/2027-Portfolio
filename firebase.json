{
  "hosting": [
    {
      "target": "main",
      "public": "build",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|png|gif|svg|webp)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "legacy",
      "public": "redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://aviv-glaser-portfolio-2027.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://aviv-glaser-portfolio-2027.web.app/:path",
          "type": 301
        }
      ]
    }
  ]
}
